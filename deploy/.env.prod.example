# Pet Grooming Media Intelligence — Production Environment Template
#
# Copy to host-only `.env.prod` OUTSIDE Git and lock permissions before editing:
#   cp deploy/.env.prod.example .env.prod && chmod 600 .env.prod
#
# Generate independent 32+ byte random secrets for EVERY secret key below:
#   openssl rand -hex 32
#
# Always validate before launching:
#   docker run --rm -v "$PWD/.env.prod:/tmp/.env.prod:ro" pgm-media-prod-collector \
#     python /srv/scripts/prod_preflight.py --env-file /tmp/.env.prod

# --- 1. Public HTTPS Domain & Edge TLS (Caddy 2) ---
STAGING_HOST=app.yourdomain.com
DASHBOARD_ORIGIN=https://app.yourdomain.com
ACME_EMAIL=ops@yourdomain.com
CADDYFILE_PATH=./Caddyfile.prod

# --- 2. Pinned Container Images ---
N8N_IMAGE=n8nio/n8n:2.48.7
CADDY_IMAGE=caddy:2.8-alpine

# --- 3. Isolated Production Storage (Dedicated Host Volume / Disk) ---
STAGING_MEDIA_DIR=/srv/pgm-media-prod/jobs
STAGING_N8N_ADMIN_PORT=5680
N8N_EDITOR_BASE_URL=http://127.0.0.1:5680

# --- 4. Core Engine & Mandatory M4 Two-Admin Separation ---
COLLECTION_ENGINE=historical
PUBLIC_COLLECTION_CHECKPOINTS=1
M4_COLLECTION_APPROVAL_ENABLED=1
WEBSITE_PROBE_DEFAULT_SITEMAPS=1
# Set both to 1 ONLY if your VPS has >= 4GB RAM and you want headless Chromium JS fallback
# for heavily client-rendered salon sites (Wix/React SPAs).
INSTALL_PLAYWRIGHT=0
PLAYWRIGHT_FALLBACK_ENABLED=0
PLAYWRIGHT_MAX_PAGES_PER_JOB=2

# --- 5. Independent Production Secrets (NEVER reuse across keys or from localhost!) ---
# Fill each key below with a unique `openssl rand -hex 32` value in host-only .env.prod.
MEDIA_WORKER_TOKEN=
MEDIA_WORKER_DASHBOARD_TOKEN=
NAMED_ASSERTION_SECRET=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
N8N_PIPELINE_TOKEN=
N8N_ADMIN_WEBHOOK_TOKEN=
# Generate fresh per production n8n instance and archive safely in your team vault
N8N_ENCRYPTION_KEY=
N8N_ADMIN_WEBHOOK_HEADER=X-Admin-Key

# --- 6. Google Drive Private Delivery Readiness ---
# Flip to 1 ONLY after configuring an isolated Production Google Drive OAuth2 credential in n8n
# and confirming a real private folder delivery (public_sharing: false).
GOOGLE_DRIVE_READY=0

# --- 7. Multimodal Vision AI Visual Director V2 (Groq OR Gemini 3 OpenAI-Compatible) ---
# Presets:
#   `on_demand` -> Groq Free / On-Demand OTPM limits (batch=1, mode_b=950, spacing=5s, cap=$0.25)
#   `dev`       -> Groq Developer Tier (batch=3, mode_b=3500, spacing=0.5s, cap=$1.50)
#   `gemini`    -> Google Gemini 3 Vision e.g. gemini-3.1-flash-lite (batch=3, mode_a=2200, mode_b=4000, spacing=1s, cap=$1.00)
#                  Endpoint: https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_TIER_PRESET=on_demand
AI_PROVIDER=openai_compatible
AI_MODEL=qwen/qwen3.8-27b
AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
AI_ALLOWED_ENDPOINTS=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_TIMEOUT_S=120
AI_MAX_RETRIES=3
AI_BOUNDED_ACCEPTANCE=0
AI_MAX_IMAGE_DIM=512
AI_MAX_IMAGE_BYTES=300000
AI_MAX_REQUEST_BYTES=1000000
AI_PRICE_IN_PER_1K=0.0008
AI_PRICE_OUT_PER_1K=0.004
# Optional explicit overrides (leave blank to inherit AI_TIER_PRESET cleanly):
AI_MODE_A_MAX_OUTPUT_TOKENS=
AI_MODE_B_MAX_OUTPUT_TOKENS=
AI_BATCH_SIZE=
AI_MAX_IMAGES_PER_REQUEST=
AI_MIN_REQUEST_SPACING_S=
AI_MAX_REQUESTS_PER_JOB=
AI_MAX_COST_USD_PER_JOB=
