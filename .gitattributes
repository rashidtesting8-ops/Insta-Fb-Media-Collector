# Normalize text files to LF in the repository; keep checkout safe on Windows.
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.mp4 binary
*.webm binary
*.mov binary
*.pdf binary
*.zip binary
*.vhdx binary
*.sqlite binary
