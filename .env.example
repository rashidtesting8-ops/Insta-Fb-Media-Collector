# Phase 1 environment template
# Copy this file to `.env` and fill in real values before `docker compose up`.
# Never commit `.env`. Never put real secrets here or in source control.

# n8n encryption key (required by n8n; generate a random value, e.g. openssl rand -hex 16)
N8N_ENCRYPTION_KEY=replace_with_random_encryption_key

# Media worker bearer token (n8n sends this in X-API-Key / Authorization)
MEDIA_WORKER_TOKEN=replace_with_random_worker_token

# Pinned official stable n8n image (approved for Phase 1)
# Phase 1 tested version: 2.48.7 (digest sha256:fabce3e9678a07d2dde83bd8f5124017f3ec457d0a3fc6b63bb4cec465d63861)
# NOTE: docker.n8n.io (n8n's registry mirror) is DNS-unresolvable on this network,
# so we use the identical official image on Docker Hub (same tags/digests).
N8N_IMAGE=n8nio/n8n:2.48.7

TZ=UTC
GENERIC_TIMEZONE=UTC
