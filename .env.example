# Phase 1 environment template — infrastructure
# Copy this file to `.env` and fill in real values before `docker compose up`.
# Never commit `.env`. Never put real secrets here or in source control.

# n8n encryption key (required by n8n; generate a random value)
N8N_ENCRYPTION_KEY=replace_with_random_encryption_key

# Media worker bearer token (n8n sends this via an n8n Credential)
MEDIA_WORKER_TOKEN=replace_with_random_worker_token

# Pinned official stable n8n image (approved for Phase 1)
# Phase 1 tested version: 2.48.7 (digest sha256:fabce3e9678a07d2dde83bd8f5124017f3ec457d0a3fc6b63bb4cec465d63861)
# NOTE: docker.n8n.io (n8n's registry mirror) is DNS-unresolvable on this network,
# so we use the identical official image on Docker Hub (same tags/digests).
N8N_IMAGE=n8nio/n8n:2.48.7

TZ=UTC
GENERIC_TIMEZONE=UTC

# --- Phase 5: AI Visual Director (optional; AI runs only when a job sets
# --- run_ai_curation=true AND a provider is configured below) -------------
# Provider: "mock" (deterministic offline tests; clearly labeled) or
# "openai_compatible" (any OpenAI-style vision chat/completions endpoint).
AI_PROVIDER=
# Example vision-capable model id for your chosen provider:
AI_MODEL=
# Example: https://api.your-provider.example/v1/chat/completions
AI_ENDPOINT=
# Secret. NEVER commit; store only in your local .env or n8n credentials.
AI_API_KEY=
# Bounded budgets and payload limits (defaults shown)
AI_TIMEOUT_S=120
AI_MAX_RETRIES=2
# Conservative multimodal payload limits (512 px / 300 KB per image)
AI_MAX_IMAGE_DIM=512
AI_MAX_IMAGE_BYTES=300000
AI_MAX_REQUEST_BYTES=1000000
# Gentle request pacing for free-tier RPM/TPM
AI_MIN_REQUEST_SPACING_S=2
# Test-mode batch size: Groq vision accepts at most 3 images per request
AI_BATCH_SIZE=1
AI_MAX_REQUESTS_PER_JOB=40
AI_MAX_COST_USD_PER_JOB=2.0
# Optional estimated-cost inputs (per 1k tokens) for usage tracking only:
AI_PRICE_IN_PER_1K=0
AI_PRICE_OUT_PER_1K=0
