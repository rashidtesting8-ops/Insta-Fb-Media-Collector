# Pet Grooming Media Intelligence — V2.1 Environment Template
# Copy this file to `.env` and fill in real values before `docker compose -f compose.media.yml up -d`.
# Never commit `.env`. Never put real secrets here or in source control.

# Host storage directory mounted as /data/projects (worker RW) and /data/media (n8n RO)
# Example on Windows with dedicated data drive: D:/pgm-media-storage/jobs
MEDIA_STORAGE_DIR=./storage/jobs

# n8n encryption key (required by n8n; generate a strong random value)
N8N_ENCRYPTION_KEY=replace_with_random_encryption_key

# Media worker admin token (n8n sends this via "Media Worker API Token" credential)
MEDIA_WORKER_TOKEN=replace_with_random_worker_token

# Pinned official stable n8n image (verified 2.48.7)
N8N_IMAGE=n8nio/n8n:2.48.7

TZ=UTC
GENERIC_TIMEZONE=UTC

# --- V2.1 Multi-Tenant Historical Collector & M4 Approval/Rights Ledger ---
COLLECTION_ENGINE=historical
PUBLIC_COLLECTION_CHECKPOINTS=1
# Probe same-origin /sitemap.xml and /sitemap_index.xml when robots.txt omits Sitemap:
WEBSITE_PROBE_DEFAULT_SITEMAPS=1
# Opt-in bounded Playwright JS fallback for SPA/JS-only galleries (requires building worker with
# --build-arg INSTALL_PLAYWRIGHT=1 and raising collector mem_limit to 2g)
PLAYWRIGHT_FALLBACK_ENABLED=0
PLAYWRIGHT_MAX_PAGES_PER_JOB=2
M4_COLLECTION_APPROVAL_ENABLED=1
# Independent >=32-byte random secret shared ONLY by frontend & worker for Named Admin HMAC assertions
NAMED_ASSERTION_SECRET=

# --- AI Visual Director V2 (Groq Vision / OpenAI-compatible multimodal) ---
# Provider: "openai_compatible" (or "groq" alias; "mock" for offline QA only)
AI_PROVIDER=openai_compatible
# Active Groq multimodal vision model (qwen/qwen3.8-27b: 2048 img tok, 8K TPM & 1K OTPM on_demand tier)
AI_MODEL=qwen/qwen3.8-27b
AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# Optional comma-separated HTTPS endpoint allowlist for defense-in-depth
AI_ALLOWED_ENDPOINTS=
# Secret. NEVER commit; store only in your local .env.
AI_API_KEY=
# Bounded budgets and payload limits (sized safely for Groq 8K TPM / 1K OTPM on_demand tier;
# raise output caps and images/req only when running on Groq Dev Tier or higher)
AI_TIMEOUT_S=120
AI_MAX_RETRIES=3
AI_BOUNDED_ACCEPTANCE=0
AI_MODE_A_MAX_OUTPUT_TOKENS=850
AI_MODE_B_MAX_OUTPUT_TOKENS=950
AI_MAX_IMAGE_DIM=512
AI_MAX_IMAGE_BYTES=300000
AI_MAX_REQUEST_BYTES=1000000
AI_MIN_REQUEST_SPACING_S=5
AI_BATCH_SIZE=1
# Keep 1 image/req on 8K TPM base tier so video frames + prompt stay under 8K TPM (up to 3 on Dev Tier)
AI_MAX_IMAGES_PER_REQUEST=1
AI_MAX_REQUESTS_PER_JOB=25
AI_MAX_COST_USD_PER_JOB=0.25
AI_PRICE_IN_PER_1K=0.0008
AI_PRICE_OUT_PER_1K=0.004

# --- Operator Dashboard & n8n Webhooks (server-side only; never use NEXT_PUBLIC_) ---
# Generate independent random tokens/secrets for each value below in your local .env
MEDIA_WORKER_DASHBOARD_TOKEN=
N8N_PIPELINE_TOKEN=
# Separate admin webhook token for 06-google-drive-delivery.json (/webhook/drive-delivery)
N8N_ADMIN_WEBHOOK_TOKEN=
N8N_ADMIN_WEBHOOK_HEADER=X-Admin-Key
# Set to 1 only after Google Drive OAuth2 credential is connected and tested in n8n
GOOGLE_DRIVE_READY=0
DASHBOARD_ORIGIN=http://localhost:3000
DASHBOARD_SESSION_SECRET=
DASHBOARD_PASSWORD=
