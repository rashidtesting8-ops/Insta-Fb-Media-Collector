      "parameters": {"jsCode": "const inputs = $input.all();\nconst uploads = inputs.map(({ json }, i) => {\n  const asset = $('Split Assets').itemMatching(i).json;\n  const ok = typeof json.id === 'string' && json.id.length > 0;\n  return {\n    upload_key: asset.upload_key,\n    drive_file_id: ok ? json.id : null,\n    drive_link: ok ? (json.webViewLink || 'https://drive.google.com/file/d/' + json.id + '/view') : null,\n    status: ok ? 'uploaded' : 'failed',\n    error: ok ? null : String((json.error && json.error.message) || json.error || 'upload_failed'),\n  };\n});\nconst firstAsset = $('Split Assets').first().json;\nreturn [{ json: { authorization_confirmed: $('Session').first().json.authorization_confirmed === true, drive_folder_id: firstAsset.drive_folder_id || null, drive_folder_link: firstAsset.drive_folder_link || null, visibility: 'private', public_sharing: false, uploads }, pairedItem: { item: 0 } }];"},
