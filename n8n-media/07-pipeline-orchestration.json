      "parameters": {"jsCode": "const plan = $('Get Delivery Plan').first().json;\nconst created = $input.first().json || {};\nconst folder = plan.drive_folder_id || created.id || null;\nconst folderLink = plan.drive_folder_link || created.webViewLink || (folder ? 'https://drive.google.com/drive/folders/' + folder : null);\nreturn (plan.pending_uploads || []).map(asset => ({ json: { ...asset, drive_folder_id: folder, drive_folder_link: folderLink }, pairedItem: { item: 0 } }));"},
