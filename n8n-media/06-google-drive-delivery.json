          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a6000000-0000-4000-8000-000000000016",
      "name": "Folder Created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1960, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'failed', job_id: $('Validate Delivery Request').first().json.job_id, error: 'Google Drive folder creation failed' }) }}",
        "options": {"responseCode": 502}
      },
      "id": "a6000000-0000-4000-8000-000000000017",
      "name": "Respond Folder Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [2180, 360]
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Validated Delivery Plan (worker)').first().json;\nconst created = $input.first().json || {};\nconst rootFolderId = plan.drive_folder_id || created.id || null;\nconst rootFolderLink = plan.drive_folder_link || created.webViewLink || (rootFolderId ? 'https://drive.google.com/drive/folders/' + rootFolderId : null);\nconst existingSubfolders = (plan.subfolders && typeof plan.subfolders === 'object') ? plan.subfolders : {};\nconst needed = new Set();\nfor (const item of (plan.pending_uploads || [])) needed.add(item.target_subfolder || (String(item.mime || '').startsWith('video/') ? 'Best Videos' : 'Best Images'));\nfor (const rep of (plan.pending_reports || [])) needed.add(rep.target_subfolder || 'Reports');\nconst toCreate = [...needed].filter((name) => !existingSubfolders[name]);\nif (toCreate.length === 0) {\n  return [{ json: { skip: true, root_folder_id: rootFolderId, root_folder_link: rootFolderLink, existing_subfolders: existingSubfolders }, pairedItem: { item: 0 } }];\n}\nreturn toCreate.map((name) => ({ json: { skip: false, name, parent_folder_id: rootFolderId, root_folder_id: rootFolderId, root_folder_link: rootFolderLink, existing_subfolders: existingSubfolders }, pairedItem: { item: 0 } }));"
      },
      "id": "a6000000-0000-4000-8000-000000000020",
      "name": "Plan Subfolders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2180, 140]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [
            {
              "id": "need-subfolders",
              "leftValue": "={{ $json.skip !== true }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a6000000-0000-4000-8000-000000000021",
      "name": "Need Subfolders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2380, 140]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "folder",
        "operation": "create",
        "name": "={{ $json.name }}",
        "driveId": {"__rl": true, "mode": "list", "value": "My Drive"},
        "folderId": {"__rl": true, "mode": "id", "value": "={{ $json.parent_folder_id }}"},
        "options": {}
      },
      "id": "a6000000-0000-4000-8000-000000000022",
      "name": "Create Drive Subfolder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "credentials": {"googleDriveOAuth2Api": {"id": "GOOGLE_DRIVE_CREDENTIAL_ID", "name": "Google Drive account"}},
      "position": [2580, 80],
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Validated Delivery Plan (worker)').first().json;\nconst plannedFirst = $('Plan Subfolders').first().json;\nconst rootFolderId = plannedFirst.root_folder_id || plan.drive_folder_id || null;\nconst rootFolderLink = plannedFirst.root_folder_link || plan.drive_folder_link || (rootFolderId ? 'https://drive.google.com/drive/folders/' + rootFolderId : null);\nconst subfolders = { ...(plannedFirst.existing_subfolders || {}) };\nif (plannedFirst.skip !== true) {\n  const plannedAll = $('Plan Subfolders').all();\n  const createdAll = $input.all();\n  createdAll.forEach(({ json }, i) => {\n    const name = json.name || (plannedAll[i] && plannedAll[i].json && plannedAll[i].json.name);\n    if (name && typeof json.id === 'string' && json.id.length > 0) {\n      subfolders[name] = json.id;\n    }\n  });\n}\nconst items = [];\nfor (const asset of (plan.pending_uploads || [])) {\n  const sub = asset.target_subfolder || (String(asset.mime || '').startsWith('video/') ? 'Best Videos' : 'Best Images');\n  items.push({\n    json: { ...asset, kind: 'media', target_subfolder: sub, target_folder_id: subfolders[sub] || rootFolderId, drive_folder_id: rootFolderId, drive_folder_link: rootFolderLink, subfolders },\n    pairedItem: { item: 0 },\n  });\n}\nfor (const report of (plan.pending_reports || [])) {\n  const sub = report.target_subfolder || 'Reports';\n  items.push({\n    json: { ...report, kind: 'report', target_subfolder: sub, target_folder_id: subfolders[sub] || rootFolderId, drive_folder_id: rootFolderId, drive_folder_link: rootFolderLink, subfolders },\n    pairedItem: { item: 0 },\n  });\n}\nreturn items;"
      },
      "id": "a6000000-0000-4000-8000-000000000018",
      "name": "Split Pending Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2800, 140]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.n8n_path }}",
        "options": {"dataPropertyName": "data"}
      },
      "id": "a6000000-0000-4000-8000-000000000006",
      "name": "Read Selected Original (binary)",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [3020, 140],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "file",
        "operation": "upload",
        "name": "={{ $('Split Pending Assets').item.json.filename }}",
        "driveId": {"__rl": true, "mode": "list", "value": "My Drive"},
        "folderId": {"__rl": true, "mode": "id", "value": "={{ $('Split Pending Assets').item.json.target_folder_id }}"},
        "inputDataFieldName": "data",
        "options": {}
      },
      "id": "a6000000-0000-4000-8000-000000000007",
      "name": "Upload Original to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "credentials": {"googleDriveOAuth2Api": {"id": "GOOGLE_DRIVE_CREDENTIAL_ID", "name": "Google Drive account"}},
      "position": [3240, 140],
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const inputs = $input.all();\nconst uploads = [];\nconst reportUploads = [];\ninputs.forEach(({ json }, i) => {\n  const item = $('Split Pending Assets').itemMatching(i).json;\n  const ok = typeof json.id === 'string' && json.id.length > 0;\n  const receipt = {\n    upload_key: item.upload_key,\n    drive_file_id: ok ? json.id : null,\n    drive_link: ok ? (json.webViewLink || 'https://drive.google.com/file/d/' + json.id + '/view') : null,\n    status: ok ? 'uploaded' : 'failed',\n    error: ok ? null : String((json.error && json.error.message) || json.error || 'upload_failed'),\n  };\n  if (item.kind === 'report') reportUploads.push(receipt);\n  else uploads.push(receipt);\n});\nconst firstItem = $('Split Pending Assets').first().json;\nreturn [{ json: {\n  authorization_confirmed: $('Validate Delivery Request').first().json.authorization_confirmed === true,\n  business_name: $('Validate Delivery Request').first().json.business_name || '',\n  drive_folder_id: firstItem.drive_folder_id || null,\n  drive_folder_link: firstItem.drive_folder_link || null,\n  subfolders: firstItem.subfolders || {},\n  visibility: 'private',\n  public_sharing: false,\n  uploads,\n  report_uploads: reportUploads,\n}, pairedItem: { item: 0 } }];"
      },
      "id": "a6000000-0000-4000-8000-000000000019",
      "name": "Collect Delivery Receipts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3460, 140]
