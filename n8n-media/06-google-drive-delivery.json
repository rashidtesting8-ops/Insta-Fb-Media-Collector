            {"id": "j2", "name": "business_name", "value": "={{ ($json.body && $json.body.business_name) ? String($json.body.business_name).trim() : 'Pet Grooming Business' }}", "type": "string"},
            {"id": "j3", "name": "authorization_confirmed", "value": "={{ $json.body?.authorization_confirmed === true }}", "type": "boolean"}
          ]
        },
        "options": {}
