          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a6000000-0000-4000-8000-000000000015",
      "name": "Existing Drive Folder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1520, 140]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "folder",
        "operation": "create",
