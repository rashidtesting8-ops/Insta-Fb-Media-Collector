        "driveId": {"__rl": true, "mode": "list", "value": "My Drive"},
        "folderId": {"__rl": true, "mode": "id", "value": "root"},
        "options": {}
      },
      "id": "a6000000-0000-4000-8000-000000000005",
      "name": "Create Business Drive Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "credentials": {"googleDriveOAuth2Api": {"id": "GOOGLE_DRIVE_CREDENTIAL_ID", "name": "Google Drive account"}},
      "position": [1740, 220],
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [
            {
              "id": "folder-ok",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "equals"}
